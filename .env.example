# Base URL of the PREMIND recorder API (../premind-recorder-api).
#
# Set it, and the app is a real client: sign-up and login issue a rotating token
# pair, recordings upload in resumable chunks, and the transcript, summary,
# concepts and quiz all come from the server's AI pass.
#
# Leave it EMPTY and the app runs entirely offline against its built-in demo
# data and a scripted on-device pipeline. Nothing is uploaded, and the study
# packs it produces are fixed sample text — a product tour, not a transcription.
#
# Local development default: http://127.0.0.1:8100
# Android emulator reaches the host at 10.0.2.2, a real device at your LAN IP.
EXPO_PUBLIC_API_URL=

# --- Social sign-in (optional) ---
# Each button appears only when this build has the key AND the server it talks
# to has one too, so leaving these empty simply hides them.
#
# Native Google login uses the WEB client ID as the ID token audience.
# Put that WEB ID in the server's GOOGLE_OAUTH_CLIENT_IDS. Android clients
# register the package + signing SHA-1; iOS needs its own client + URL scheme.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# Kakao REST API key, from the Kakao developers console. The console's app id
# (a number) goes in the server's KAKAO_APP_ID. The server also needs
# KAKAO_REST_API_KEY, KAKAO_CLIENT_SECRET and KAKAO_REDIRECT_URI.
# Never put the client secret in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_KAKAO_REST_KEY=
# Enable only after the published terms/privacy notice covers Kakao sign-up.
EXPO_PUBLIC_ENABLE_KAKAO_AUTH=false

# --- Store billing (optional) ---
# RevenueCat public SDK keys, one per store. With a key present (and a
# development/release build — Expo Go has no billing module) the 구독 screen
# sells the subscription through Google Play / the App Store, as store policy
# requires. Products: premind_standard_monthly, premind_standard_yearly;
# entitlement: standard. Leave empty and the screen only explains the plan.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
